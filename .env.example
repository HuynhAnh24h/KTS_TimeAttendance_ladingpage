# Cấu hình cổng chạy Server
PORT=5000
NODE_ENV=development

# Kết nối cơ sở dữ liệu MongoDB Atlas (100% Miễn phí M0 Cluster)
# Ví dụ: mongodb+srv://username:password@cluster0.abcde.mongodb.net/kts_license?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kts_license_portal

# Khóa bí mật ký License Key (Phải trùng khớp với MASTER_SECRET trong phần mềm desktop kts-cham-cong)
MASTER_SECRET=KTS-ENTERPRISE-FACTORY-SECURE-KEY-2026-HUYNHANH-KORNBEST-AI

# JWT Secret bảo mật phiên đăng nhập Quản trị viên
JWT_SECRET=KTS-LICENSE-PORTAL-SUPER-SECRET-JWT-KEY-2026

# Tài khoản Quản trị viên khởi tạo ban đầu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=KtsAdmin@2026

# Thông tin tài khoản ngân hàng để tạo mã VietQR tự động 24/7
BANK_ID=MB
BANK_ACCOUNT_NO=0987654321
BANK_ACCOUNT_NAME=NGUYEN HUYNH ANH
